  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 40,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_\\-\\u4e00-\\u9fff]+$",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Account"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Limits": {
        "properties": {
          "min_choices": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Choices"
          },
          "max_choices": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Choices"
          },
          "min_length": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Length"
          },
          "max_length": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 10000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Length"
          },
          "min_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Value"
          },
          "max_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Value"
          },
          "integer": {
            "type": "boolean",
            "title": "Integer",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Limits"
      },
      "Preview": {
        "properties": {
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answers"
        ],
        "title": "Preview"
      },
      "Question": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,39}$",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "type": {
            "type": "string",
            "enum": [
              "single",
              "multiple",
              "text",
              "number"
            ],
            "title": "Type"
          },
          "required": {
            "type": "boolean",
            "title": "Required",
            "default": true
          },
          "options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Options"
          },
          "validation": {
            "$ref": "#/components/schemas/Limits"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/Rule"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Rules"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "title",
          "type"
        ],
        "title": "Question"
      },
      "Rule": {
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "eq",
              "contains",
              "contains_all",
              "gt",
              "gte",
              "lt",
              "lte",
              "between"
            ],
            "title": "Op"
          },
          "value": {
            "title": "Value"
          },
          "target": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "title": "Target"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "op",
          "value",
          "target"
        ],
        "title": "Rule"
      },
      "Submission": {
        "properties": {
          "answers": {
            "additionalProperties": true,
            "type": "object",
            "title": "Answers"
          },
          "anonymous": {
            "type": "boolean",
            "title": "Anonymous",
            "default": false
          },
          "request_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Request Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answers",
          "request_id"
        ],
        "title": "Submission"
      },
      "SurveyInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 3000,
            "title": "Description",
            "default": ""
          },
          "allow_anonymous": {
            "type": "boolean",
            "title": "Allow Anonymous",
            "default": true
          },
          "allow_multiple": {
            "type": "boolean",
            "title": "Allow Multiple",
            "default": false
          },
          "deadline": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deadline"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",

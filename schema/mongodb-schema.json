{
  "schema_version": 2,
  "compatible_legacy_versions": [
    1
  ],
  "collections": {
    "users": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "username",
              "password_hash",
              "created_at"
            ],
            "properties": {
              "username": {
                "bsonType": "string"
              },
              "password_hash": {
                "bsonType": "string"
              },
              "created_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "uq_username": {
          "v": 2,
          "key": [
            [
              "username",
              1
            ]
          ],
          "unique": true
        }
      }
    },
    "sessions": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "token_hash",
              "user_id",
              "expires_at"
            ],
            "properties": {
              "token_hash": {
                "bsonType": "string"
              },
              "user_id": {
                "bsonType": "objectId"
              },
              "expires_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "uq_session_token": {
          "v": 2,
          "key": [
            [
              "token_hash",
              1
            ]
          ],
          "unique": true
        },
        "ttl_session": {
          "v": 2,
          "key": [
            [
              "expires_at",
              1
            ]
          ],
          "expireAfterSeconds": 0
        }
      }
    },
    "surveys": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "owner_id",
              "title",
              "status",
              "questions",
              "schema_version",
              "revision"
            ],
            "properties": {
              "owner_id": {
                "bsonType": "objectId"
              },
              "title": {
                "bsonType": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "published",
                  "closed"
                ]
              },
              "questions": {
                "bsonType": "array"
              },
              "schema_version": {
                "enum": [
                  1,
                  2
                ]
              },
              "revision": {
                "bsonType": "int"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "owner_recent": {
          "v": 2,
          "key": [
            [
              "owner_id",
              1
            ],
            [
              "created_at",
              -1
            ]
          ]
        },
        "status_deadline": {
          "v": 2,
          "key": [
            [
              "status",
              1
            ],
            [
              "deadline",
              1
            ]
          ]
        },
        "question_root_usage": {
          "v": 2,
          "key": [
            [
              "questions.source.root_id",
              1
            ]
          ]
        },
        "question_version_usage": {
          "v": 2,
          "key": [
            [
              "questions.source.version_id",
              1
            ]
          ]
        }
      }
    },
    "responses": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "survey_id",
              "survey_revision",
              "respondent_key",
              "request_id",
              "answers",
              "path",
              "submitted_at"
            ],
            "properties": {
              "survey_id": {
                "bsonType": "objectId"
              },
              "survey_revision": {
                "bsonType": "int"
              },
              "respondent_key": {
                "bsonType": "string"
              },
              "answers": {
                "bsonType": "object"
              },
              "path": {
                "bsonType": "array"
              },
              "submitted_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "survey_time": {
          "v": 2,
          "key": [
            [
              "survey_id",
              1
            ],
            [
              "submitted_at",
              -1
            ]
          ]
        },
        "uq_idempotency": {
          "v": 2,
          "key": [
            [
              "survey_id",
              1
            ],
            [
              "respondent_key",
              1
            ],
            [
              "request_id",
              1
            ]
          ],
          "unique": true
        },
        "uq_single_response": {
          "v": 2,
          "key": [
            [
              "survey_id",
              1
            ],
            [
              "single_key",
              1
            ]
          ],
          "unique": true,
          "partialFilterExpression": {
            "single_key": {
              "$type": "string"
            }
          }
        }
      }
    },
    "question_roots": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "owner_id",
              "next_version",
              "created_at"
            ],
            "properties": {
              "owner_id": {
                "bsonType": "objectId"
              },
              "next_version": {
                "bsonType": "int"
              },
              "created_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "root_owner_recent": {
          "v": 2,
          "key": [
            [
              "owner_id",
              1
            ],
            [
              "created_at",
              -1
            ]
          ]
        }
      }
    },
    "question_versions": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "root_id",
              "number",
              "definition",
              "fingerprint",
              "created_at"
            ],
            "properties": {
              "root_id": {
                "bsonType": "objectId"
              },
              "number": {
                "bsonType": "int"
              },
              "definition": {
                "bsonType": "object"
              },
              "fingerprint": {
                "bsonType": "string"
              },
              "parent_version_id": {
                "bsonType": [
                  "objectId",
                  "null"
                ]
              },
              "created_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "uq_root_version": {
          "v": 2,
          "key": [
            [
              "root_id",
              1
            ],
            [
              "number",
              -1
            ]
          ],
          "unique": true
        },
        "version_parent": {
          "v": 2,
          "key": [
            [
              "parent_version_id",
              1
            ]
          ]
        }
      }
    },
    "question_shares": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "root_id",
              "grantee_id",
              "created_at"
            ],
            "properties": {
              "root_id": {
                "bsonType": "objectId"
              },
              "grantee_id": {
                "bsonType": "objectId"
              },
              "created_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "uq_root_grantee": {
          "v": 2,
          "key": [
            [
              "root_id",
              1
            ],
            [
              "grantee_id",
              1
            ]
          ],
          "unique": true
        },
        "grantee_roots": {
          "v": 2,
          "key": [
            [
              "grantee_id",
              1
            ],
            [
              "created_at",
              -1
            ]
          ]
        }
      }
    },
    "question_banks": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "owner_id",
              "name",
              "revision",
              "archived"
            ],
            "properties": {
              "owner_id": {
                "bsonType": "objectId"
              },
              "name": {
                "bsonType": "string"
              },
              "revision": {
                "bsonType": "int"
              },
              "archived": {
                "bsonType": "bool"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "owner_active_banks": {
          "v": 2,
          "key": [
            [
              "owner_id",
              1
            ],
            [
              "archived",
              1
            ]
          ]
        }
      }
    },
    "bank_items": {
      "options": {
        "validator": {
          "$jsonSchema": {
            "bsonType": "object",
            "required": [
              "bank_id",
              "root_id",
              "version_id",
              "updated_at"
            ],
            "properties": {
              "bank_id": {
                "bsonType": "objectId"
              },
              "root_id": {
                "bsonType": "objectId"
              },
              "version_id": {
                "bsonType": "objectId"
              },
              "updated_at": {
                "bsonType": "date"
              }
            }
          }
        }
      },
      "indexes": {
        "_id_": {
          "v": 2,
          "key": [
            [
              "_id",
              1
            ]
          ]
        },
        "uq_bank_root": {
          "v": 2,
          "key": [
            [
              "bank_id",
              1
            ],
            [
              "root_id",
              1
            ]
          ],
          "unique": true
        }
      }
    }
  }
}